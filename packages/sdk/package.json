{
  "name": "@zxiaosi-micro/sdk",
  "version": "0.1.5",
  "description": "A micro frontend kit",
  "license": "MIT",
  "author": "zxiaosi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxiaosi-micro/frontend-sdk.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.5",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
